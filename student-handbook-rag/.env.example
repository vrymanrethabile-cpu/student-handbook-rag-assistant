# LLM Provider Configuration
# Supported providers: openai, anthropic, google, groq, ollama
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# API keys - NEVER commit real keys. Copy this file to .env and fill in values.
OPENAI_API_KEY=your-openai-api-key-here
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# GOOGLE_API_KEY=your-google-api-key-here
# GROQ_API_KEY=your-groq-api-key-here
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# OLLAMA_BASE_URL=http://localhost:11434

# Sentence Transformers embedding model
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ChromaDB persistent storage
CHROMA_DB_PATH=./chroma_db
CHROMA_COLLECTION_NAME=student_handbook

# Retrieval settings
RETRIEVAL_TOP_K=20
SIMILARITY_THRESHOLD=0.3

# Handbook PDF location (relative to project root)
HANDBOOK_PDF_PATH=data/student_handbook.pdf
